# --------------------------------------------------------------------
# 1. AI Model Providers (Optional - Can also be configured directly in UI)
# --------------------------------------------------------------------

# OpenAI API Key: Required for GPT-4o comparative analysis
# Get your key here: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key: Recommended for fast, free-tier transcripts and reasoning
# Get your key here: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# --------------------------------------------------------------------
# 2. Server Settings
# --------------------------------------------------------------------
PORT=8000
HOST=127.0.0.1
DEBUG=True
